@charset "utf-8";

:root { --ink: #3e3532; --muted: #756c68; --cream: #fffaf4; --paper: #fff; --coral: #ef806f; --sage: #90ad91; --gold: #e9b95d; --violet: #9a82b7; --line: #eadfd5; --shadow: 0 18px 50px #6f51451a; }

* { box-sizing: border-box; }

body { margin: 0px; font-family: Inter, ui-rounded, "Segoe UI", system-ui, sans-serif; background: linear-gradient(145deg, rgb(255, 250, 244), rgb(255, 247, 239) 45%, rgb(247, 242, 248)); color: var(--ink); min-height: 100vh; }

.wrap { max-width: 1050px; margin: auto; padding: 28px 20px 70px; }

.top { display: flex; align-items: center; justify-content: space-between; gap: 15px; }

.brand { font-family: Georgia, serif; font-size: 34px; font-weight: 700; }

.brand i { color: var(--coral); font-style: normal; }

.tag { color: var(--muted); font-size: 14px; margin-top: 3px; }

.ver { font-size: 12px; color: rgb(139, 129, 124); background: rgba(255, 255, 255, 0.6); border: 1px solid var(--line); padding: 6px 10px; border-radius: 999px; }

.hero { text-align: center; padding: 70px 10px 38px; }

.hero h1 { font: 700 clamp(36px, 7vw, 66px) / 1.05 Georgia, serif; margin: 0px auto 14px; max-width: 780px; }

.hero p { font-size: 18px; color: var(--muted); max-width: 650px; margin: auto; }

.cards { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }

.card { background: rgba(255, 255, 255, 0.8); border: 1px solid rgb(255, 255, 255); box-shadow: var(--shadow); border-radius: 28px; padding: 28px; min-height: 255px; display: flex; flex-direction: column; justify-content: space-between; }

.icon { width: 58px; height: 58px; border-radius: 18px; display: grid; place-items: center; font-size: 29px; }

.event .icon { background: rgb(255, 226, 220); }

.memory .icon { background: rgb(228, 238, 227); }

.card h2 { font: 700 28px Georgia, serif; margin: 20px 0px 8px; }

.card p { color: var(--muted); line-height: 1.5; }

.btn { border: 0px; border-radius: 14px; padding: 13px 17px; font-weight: 700; cursor: pointer; font-size: 15px; }

.primary { background: var(--coral); color: white; }

.sage { background: var(--sage); color: white; }

.ghost { background: rgb(255, 255, 255); border: 1px solid var(--line); color: var(--ink); }

.features { display: flex; justify-content: center; gap: 24px; flex-wrap: wrap; margin-top: 32px; color: var(--muted); font-size: 14px; }

.panel { max-width: 650px; margin: 38px auto 0px; background: rgba(255, 255, 255, 0.867); border: 1px solid rgb(255, 255, 255); border-radius: 28px; padding: 28px; box-shadow: var(--shadow); }

.panel h2 { font: 700 30px Georgia, serif; margin: 0px 0px 8px; }

.field { margin: 16px 0px; }

.field label { display: block; font-size: 13px; font-weight: 700; margin: 0px 0px 7px; }

.field input, .field textarea, .field select { width: 100%; border: 1px solid var(--line); border-radius: 13px; padding: 13px; background: white; font: inherit; color: inherit; }

.row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }

.actions { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 20px; }

.notice { padding: 12px 14px; border-radius: 12px; background: rgb(255, 243, 220); color: rgb(115, 88, 39); font-size: 14px; margin: 14px 0px; }

.success { background: rgb(234, 244, 233); color: rgb(63, 102, 66); }

.hidden { display: none !important; }

.eventbox { padding: 20px; border: 1px solid var(--line); border-radius: 18px; margin-top: 15px; background: white; }

.eventbox h3 { margin: 0px 0px 5px; }

.pill { display: inline-block; padding: 5px 9px; border-radius: 999px; background: rgb(234, 244, 233); color: rgb(71, 106, 73); font-size: 12px; font-weight: 700; }

.qr { background: rgb(255, 255, 255); padding: 14px; border-radius: 16px; display: inline-block; margin: 12px 0px; }

.tiny { font-size: 12px; color: var(--muted); word-break: break-all; }

.footer { text-align: center; color: rgb(154, 143, 137); font-size: 12px; margin-top: 50px; }

@media (max-width: 700px) {
  .cards { grid-template-columns: 1fr; }
  .hero { padding-top: 48px; }
  .row { grid-template-columns: 1fr; }
  .brand { font-size: 29px; }
}

.sunshine { background: rgb(243, 199, 95); color: rgb(73, 59, 29); }

.authpanel { background: linear-gradient(145deg, rgb(255, 253, 249), rgb(255, 241, 235) 48%, rgb(243, 238, 249)); position: relative; overflow: hidden; }

.authpanel::before { content: ""; position: absolute; width: 180px; height: 180px; border-radius: 50%; background: rgba(248, 215, 105, 0.333); right: -70px; top: -75px; }

.authart { display: flex; gap: 10px; margin-bottom: 18px; }

.authart span { width: 50px; height: 50px; border-radius: 17px; display: grid; place-items: center; font-size: 25px; box-shadow: rgba(111, 81, 69, 0.11) 0px 8px 22px; }

.authart span:nth-child(1) { background: rgb(255, 217, 209); transform: rotate(-5deg); }

.authart span:nth-child(2) { background: rgb(255, 240, 185); transform: rotate(5deg); }

.authart span:nth-child(3) { background: rgb(229, 220, 242); transform: rotate(-2deg); }

body::before { content: ""; position: fixed; inset: 0px; pointer-events: none; background: radial-gradient(circle at 8% 18%, rgba(255, 215, 206, 0.533) 0px, rgba(255, 215, 206, 0.533) 8%, transparent 18%), radial-gradient(circle at 92% 22%, rgba(249, 227, 154, 0.467) 0px, rgba(249, 227, 154, 0.467) 7%, transparent 17%), radial-gradient(circle at 85% 80%, rgba(220, 208, 237, 0.467) 0px, rgba(220, 208, 237, 0.467) 8%, transparent 19%), radial-gradient(circle at 12% 82%, rgba(217, 233, 215, 0.467) 0px, rgba(217, 233, 215, 0.467) 7%, transparent 18%); z-index: -1; }

.hero::before { content: "✦"; color: rgb(231, 181, 79); font-size: 26px; display: block; margin-bottom: 10px; }

.card { transition: transform 0.2s, box-shadow 0.2s; overflow: hidden; position: relative; }

.card:hover { transform: translateY(-3px); box-shadow: rgba(111, 81, 69, 0.15) 0px 22px 55px; }

.event { background: linear-gradient(145deg, rgb(255, 255, 255), rgb(255, 240, 235)); }

.memory { background: linear-gradient(145deg, rgb(255, 255, 255), rgb(237, 246, 235)); }

.event::after, .memory::after { content: ""; position: absolute; width: 130px; height: 130px; border-radius: 50%; right: -48px; top: -45px; opacity: 0.5; }

.event::after { background: rgb(255, 208, 198); }

.memory::after { background: rgb(207, 227, 203); }

.features span { background: rgba(255, 255, 255, 0.72); border: 1px solid rgb(255, 255, 255); padding: 9px 13px; border-radius: 999px; box-shadow: rgba(111, 81, 69, 0.063) 0px 7px 18px; }

.top { background: rgba(255, 255, 255, 0.56); backdrop-filter: blur(10px); padding: 12px 15px; border-radius: 20px; border: 1px solid rgb(255, 255, 255); }

.brand i { background-image: ; background-position-x: ; background-position-y: ; background-size: ; background-repeat: ; background-attachment: ; background-origin: ; background-color: ; background-clip: text; color: transparent; }
